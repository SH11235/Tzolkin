{
  "name": "tzolkin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @long",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write src tests scripts *.ts *.js *.json index.html README.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.ts *.js *.json index.html README.md .github/workflows/*.yml",
    "build:wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run build:wasm",
    "prebuild": "npm run build:wasm",
    "pretypecheck": "npm run build:wasm",
    "pretest": "node scripts/build-wasm.mjs --test",
    "pretest:watch": "node scripts/build-wasm.mjs --test",
    "pretest:e2e": "node scripts/build-wasm.mjs --test",
    "test:core": "cargo nextest run --locked -p tzolkin-core -p tzolkin-bot -p tzolkin-ai -p tzolkin-inference && cargo test --locked --doc -p tzolkin-core -p tzolkin-bot -p tzolkin-ai -p tzolkin-inference",
    "test:bga": "node --test scripts/bga-import.test.mjs scripts/bga-replay.test.mjs scripts/bga-qualify.test.mjs scripts/bga-decode.test.mjs",
    "bga:import": "node scripts/bga-import.mjs",
    "bga:compare": "node scripts/bga-compare.mjs",
    "bga:replay": "node scripts/bga-replay.mjs",
    "test:e2e:long": "playwright test --grep @long",
    "test:e2e:full": "playwright test",
    "pretest:e2e:long": "node scripts/build-wasm.mjs --test",
    "pretest:e2e:full": "node scripts/build-wasm.mjs --test",
    "test:core:full": "cargo nextest run --locked -p tzolkin-core -p tzolkin-bot -p tzolkin-ai -p tzolkin-inference --run-ignored all && cargo test --locked --doc -p tzolkin-core -p tzolkin-bot -p tzolkin-ai -p tzolkin-inference",
    "test:ml:slow": "cargo test --locked -p tzolkin-ai -- --ignored"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
